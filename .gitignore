Derived/
Figures/
Rendered/

# Quarto build artifacts (scoped to Scripts/qmd/ so this never shadows real
# source files elsewhere, e.g. Suppfiles/title.tex or _extensions/**/*.cls|*.bst)
Scripts/qmd/*_files/
Scripts/qmd/*_cache/
Scripts/qmd/*.tex
Scripts/qmd/*.log
Scripts/qmd/*.aux
Scripts/qmd/*.toc
Scripts/qmd/*.pdf
Scripts/qmd/*.spl
Scripts/qmd/*.cls
Scripts/qmd/*.bst

# Not needed to reproduce the render (Quarto reinstalls this extension via
# `quarto add quarto-journals/elsevier`; kept locally, just not tracked)
_extensions/quarto-journals/elsevier/

# Elsevier style-guide reference/example material, not used by any script or
# _quarto.yml (kept locally, just not tracked)
Suppfiles/style-guide/

